# Puerto del servidor
PORT=3000

# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-supabase-key-anon-o-service
SUPABASE_ANON_KEY=tu-supabase-key-anon-o-service

# Service Role Key de Supabase (Settings → API → service_role).
# NECESARIA para las rutas /api/admin/* (listar usuarios y restablecer
# contraseñas de cualquier usuario). Tiene privilegios totales sobre la base
# de datos y Auth: nunca la publiques, nunca la pongas en el frontend, y
# configúrala solo como variable de entorno en el panel de Render (no en
# este repositorio).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
